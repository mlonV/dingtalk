package dnsquery

import (
	"context"
	"net"
	"strings"
	"time"

	"github.com/miekg/dns"
	"github.com/mlonV/dingtalk/config"
	"github.com/mlonV/dingtalk/prome"
	"github.com/prometheus/client_golang/prometheus"
)

type Metrics struct {
	server   string
	domain   string
	cname    string
	arecord  []string
	DnsGauge prometheus.Gauge
}

var (
	serverCache = make(map[string]map[string]*Metrics)
	// { server : { domain : cname }}

	// domainCache = make(map[string]string) // Cache to store the last known CNAME for each domain
)

func NewMetrics(server, domain, cname string, arecord []string) *Metrics {
	return &Metrics{
		server: server,
		domain: domain,
		cname:  cname,
		DnsGauge: prometheus.NewGauge(prometheus.GaugeOpts{
			Namespace: "karawangroup",
			Subsystem: "dns",
			Name:      "dnsquery",
			Help:      "Indicates if there is a change in CNAME record (1 for change, 0 for no change)",
			ConstLabels: map[string]string{
				"server":  server,
				"domain":  domain,
				"arecord": strings.Join(arecord, ","),
				"CNAME":   cname,
			},
		}),
	}
}

func worker(ctx context.Context) {
	config.Log.Info("Starting DNS Query Worker, Interval: %ds", config.Conf.DnsQuery.Interval)
	interval := time.Duration(config.Conf.DnsQuery.Interval) * time.Second
	ticker := time.NewTicker(interval)
	defer ticker.Stop()

	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			for _, server := range config.Conf.DnsQuery.Servers {
				for _, domain := range config.Conf.DnsQuery.Domains {
					queryDNS(domain, server)
				}
			}
		}
	}
}

func queryDNS(domain, server string) {
	msg := new(dns.Msg)
	msg.SetQuestion(dns.Fqdn(domain), dns.TypeA)

	in, err := dns.Exchange(msg, net.JoinHostPort(server, "53"))
	if err != nil {
		// fmt.Println("DNS query failed for %s on %s in.Rcode : %s   err: %s ", domain, server, in.Rcode, err.Error())
		config.Log.Error("DNS query failed for %s on %s   err:  ", domain, server, err)
		metrics := NewMetrics(server, domain, "", []string{})
		prome.PromeRegister.Register(metrics.DnsGauge)
		metrics.DnsGauge.Set(100)
		return
	}

	if in.Rcode != dns.RcodeSuccess {
		metrics := NewMetrics(server, domain, "nosuccess", []string{})
		prome.PromeRegister.Register(metrics.DnsGauge)
		metrics.DnsGauge.Set(float64(in.Rcode))
		return
	}

	var currentCNAME string
	arecord := make([]string, 0)
	for _, answer := range in.Answer {
		if aRecord, ok := answer.(*dns.A); ok {
			arecord = append(arecord, aRecord.A.String())
			config.Log.Info("domainserver: %s domain : %s   A record: %s\n", server, domain, aRecord.A.String())
		}
		if cnameRecord, ok := answer.(*dns.CNAME); ok {
			currentCNAME = cnameRecord.Target

			config.Log.Info("domainserver: %s domain : %s  CName record: %#v\n", server, domain, cnameRecord.Target)
		}
	}

	// Check if the CNAME has changed
	metrics, exists := serverCache[server][domain]
	if metrics == nil {
		metrics = NewMetrics(server, domain, currentCNAME, arecord)
		prome.PromeRegister.Register(metrics.DnsGauge)
	}

	if currentCNAME != metrics.cname {
		if exists {
			config.Log.Info("CNAME for domain %s changed from %s to %s", domain, metrics.cname, currentCNAME)
		} else {
			serverCache[server][domain] = metrics
			config.Log.Info("Initial CNAME for domain %s is %s", domain, currentCNAME)
		}
		metrics.DnsGauge.Set(1)
	} else {
		// config.Log.Info("No change in CNAME for domain %s", domain)
		metrics.DnsGauge.Set(0)
	}
	// fmt.Println("serverCache:", serverCache)
}

func StartDNSQueryWorker(ctx context.Context) {
	go worker(ctx)
}
